material EarthTextured
{
    technique
    {
        pass
        {
            cull_hardware none

            vertex_program_ref PlanetVS
            {
            }
            fragment_program_ref EarthFS
            {
                param_named diffuseMap int 0
                param_named_auto lightPos light_position 0
                param_named_auto ambient ambient_light_colour
                param_named_auto cameraPos camera_position
                param_named tint float4 1 1 1 1
                param_named atmosphere float4 0.35 0.6 1 0.9
                param_named nightMap int 1
                param_named spot float4 0 0 0 0
            }

            texture_unit
            {
                texture 2k_earth_daymap.jpg
                tex_address_mode wrap
            }
            texture_unit
            {
                texture 2k_earth_nightmap.jpg
                tex_address_mode wrap
            }

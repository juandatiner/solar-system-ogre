// Materials for solar_system.scenepp.
// Textures: Solar System Scope (https://www.solarsystemscope.com/textures/),
// licensed under CC BY 4.0. The texture of Ceres is an artistic recreation.
// No real texture is used for Pluto and the small moons: they are the Moon's,
// tinted with an approximate colour.

vertex_program PlanetVS glsl
{
    source planet.vert
    default_params
    {
        param_named_auto worldViewProj worldviewproj_matrix
        param_named_auto world world_matrix
    }
}

fragment_program PlanetFS glsl
{
    source planet.frag
}

fragment_program EarthFS glsl
{
    source planet.frag
    preprocessor_defines EARTH=1
}

fragment_program SaturnFS glsl
{
    source planet.frag
    preprocessor_defines SATURN=1
}

fragment_program CloudsFS glsl
{
    source planet.frag
    preprocessor_defines CLOUDS=1
}

fragment_program RingFS glsl
{
    source ring.frag
}

material SunTextured
{
    technique
    {
        pass
        {
            lighting off
            cull_hardware none

            texture_unit
            {
                texture 2k_sun.jpg
                tex_address_mode wrap
            }
        }
    }
}

material StarsTextured
{
    technique
    {
        pass
        {
            lighting off
            cull_hardware none
            depth_check off
            depth_write off

            texture_unit
            {
                texture 2k_stars_milky_way.jpg
                tex_address_mode wrap
            }
        }
    }
}

material SunGlow
{
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off

            texture_unit
            {
                texture sun_glow.png
                tex_address_mode clamp
            }
        }
    }
}

material AsteroidDot
{
    technique
    {
        pass
        {
            lighting off
            scene_blend alpha_blend
            depth_write off

            texture_unit
            {
                texture sun_glow.png
                tex_address_mode clamp
            }
        }
    }
}

material CometPuff
{
    technique
    {
        pass
        {
            lighting off
            scene_blend add
            depth_write off

            texture_unit
            {
                texture sun_glow.png
                tex_address_mode clamp
            }
        }
    }
}

// Uses the vertex colours set by the viewer
material OrbitLine
{
    technique
    {
        pass
        {
            lighting off
            scene_blend alpha_blend
            depth_write off
        }
    }
}

material SaturnRingTextured
{
    technique
    {
        pass
        {
            lighting off
            cull_hardware none
            scene_blend alpha_blend
            depth_write off

            vertex_program_ref PlanetVS
            {
            }
            fragment_program_ref RingFS
            {
                param_named diffuseMap int 0
                param_named_auto lightPos light_position 0
                param_named planet float4 0 0 0 1
            }

            texture_unit
            {
                texture 2k_saturn_ring_alpha.png
                tex_address_mode clamp
            }
        }
    }
}

material EarthClouds
{
    technique
    {
        pass
        {
            cull_hardware none
            scene_blend alpha_blend
            depth_write off

            vertex_program_ref PlanetVS
            {
            }
            fragment_program_ref CloudsFS
            {
                param_named diffuseMap int 0
                param_named_auto lightPos light_position 0
                param_named_auto ambient ambient_light_colour
            }

            texture_unit
            {
                texture 2k_earth_clouds.jpg
                tex_address_mode wrap
            }
        }
    }
}


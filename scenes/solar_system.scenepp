<?xml version="1.0" encoding="UTF-8"?>
<scene formatVersion="1.1">

  <environment>
    <colourAmbient r="0.05" g="0.05" b="0.07"/>
  </environment>

  <parametricSurfaces>
      <!-- u = longitude, v = latitude (north to south, along -Y): matches the
           equirectangular textures. join="false" keeps the texture seam clean. -->
      <parametricSurface name="Sphere" uResolution="64" vResolution="32">
        <uRange min="0" max="6.283185307" join="false"/>
        <vRange min="0" max="3.141592653" join="false"/>
        <param name="R" value="1"/>
        <point  x="R*sin(v)*cos(u)" y="R*cos(v)" z="-R*sin(v)*sin(u)"/>
        <normal x="sin(v)*cos(u)"   y="cos(v)"   z="-sin(v)*sin(u)"/>
      </parametricSurface>

      <!-- Flat ring: u goes from the inner to the outer edge, along the texture. -->
      <parametricSurface name="Ring" uResolution="2" vResolution="128">
        <uRange min="0" max="1" join="false"/>
        <vRange min="0" max="6.283185307" join="false"/>
        <param name="inner" value="1.24"/>
        <param name="outer" value="2.27"/>
        <point  x="(inner+(outer-inner)*u)*cos(v)" y="0" z="(inner+(outer-inner)*u)*sin(v)"/>
        <normal x="0" y="1" z="0"/>
      </parametricSurface>
  </parametricSurfaces>

  <!-- Sizes and distances are compressed so every body stays visible from the
       Sun view; only their order is real. Sun = 20, Earth = 2, Moon = 0.4.
       Real: orbital periods, spin periods, eccentricities, inclinations, axial
       tilts, and positions along each orbit (close to those of January 2000).
       The comet keeps the real period and inclination of Halley, but a smaller
       eccentricity: the real one would take it out of the view.

       Node properties read by the viewer:
       - orbitSemiMajor, orbitEccentricity, orbitInclination, orbitNode,
         orbitPerihelion, orbitPeriod (days), orbitAnomaly (at day zero): moves
         the node around its parent following Kepler's laws. Angles in degrees.
       - spinSpeed: degrees per simulated day around the node's own axis.
       - cameraDistance: the arrow keys can focus on this node, in file order.
       - label: name of the node in the on-screen menu.
       - info: "radius|distance|orbit|spin|tilt", shown when selected.
       - followCamera: background that stays centered on the camera.
       - glowSize: glow around the node.
       - beltCount, beltInner, beltOuter: belt of small rocks.
       - cometTail: tail that points away from the Sun.
       A <rotation> around Z on a spinning node is its axial tilt. Bodies with
       children are split in two nodes, so their spin and scale do not affect
       the children. -->
  <nodes>

    <node name="Stars">
      <scale x="500" y="500" z="500"/>
      <parametricSurface ref="Sphere" material="StarsTextured" castShadows="false"/>
      <userData>
        <property name="followCamera" type="bool" data="true"/>
      </userData>
    </node>

    <node name="Sun">
      <light name="SunLight" type="point" castShadows="false">
        <colourDiffuse r="1" g="0.96" b="0.88"/>
      </light>
      <userData>
        <property name="glowSize" type="float" data="110"/>
        <property name="cameraDistance" type="float" data="365"/>
        <property name="label" type="string" data="Sol"/>
        <property name="info" type="string" data="696340 km|-|-|25 dias|7.25"/>
      </userData>

      <node name="SunBody">
        <rotation angleX="0" angleY="0" angleZ="7.25"/>
        <scale x="20" y="20" z="20"/>
        <parametricSurface ref="Sphere" material="SunTextured"/>
        <userData>
          <property name="spinSpeed" type="float" data="14.37"/>
        </userData>
      </node>
    </node>

    <node name="Mercury">
      <userData>
        <property name="orbitSemiMajor" type="float" data="28"/>
        <property name="orbitEccentricity" type="float" data="0.2056"/>
        <property name="orbitInclination" type="float" data="7.0"/>
        <property name="orbitNode" type="float" data="48.3"/>
        <property name="orbitPerihelion" type="float" data="29.1"/>
        <property name="orbitPeriod" type="float" data="88"/>
        <property name="orbitAnomaly" type="float" data="174.8"/>
        <property name="cameraDistance" type="float" data="5"/>

      </userData>

      <node name="MercuryBody">
        <rotation angleX="0" angleY="0" angleZ="0.03"/>
        <scale x="1" y="1" z="1"/>
        <parametricSurface ref="Sphere" material="MercuryTextured"/>
        <userData>
          <property name="spinSpeed" type="float" data="6.138"/>
        </userData>
      </node>
    </node>

